# Gemini API key — https://aistudio.google.com/apikey
# NEVER commit the real value. Only this example file belongs in git.
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model. Must be Gemini 3.5 or newer per the hackathon rules.
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried only when the primary returns 503 / times out.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=25000

# How many vision calls run at once during a scan. Higher provokes 503s.
SCAN_CONCURRENCY=4

PORT=8080

# ---- Google Cloud (optional locally; memory falls back to a JSON file) ----
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# CORS_ORIGIN=https://your-frontend.run.app
